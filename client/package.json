{
  "name": "isduba-client",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:test": "vite build --config vite.test-config.js",
    "preview": "vite preview",
    "test": "npm run test:integration && npm run test:unit",
    "start": "vite",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --cache . && eslint --cache .",
    "lint:prettier": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:integration": "playwright test",
    "cover": "npm run cover:unit && npm run cover:integration",
    "cover:unit": "nyc --silent npm run test:unit",
    "cover:integration": "nyc --silent --no-clean npm run test:integration",
    "prepare": "cd .. && husky client/.husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/eslint": "9.6.1",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.15.1",
    "@types/sortablejs": "^1.15.9",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-istanbul": "^8.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "husky": "^9.1.7",
    "monocart-reporter": "^2.15.1",
    "nyc": "^18.0.0",
    "postcss": "^8.5.31",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "source-map-support": "^0.5.21",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "dependencies": {
    "@boxicons/svelte": "^1.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chroma-js": "^3.1.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "chroma-js": "^3.2.0",
    "debounce": "^3.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "jwt-decode": "^4.0.0",
    "moment": "^2.31.0",
    "oidc-client-ts": "^3.5.0",
    "qs": "^6.16.1",
    "sortablejs": "^1.15.7",
    "svelte-spa-router": "^5.1.1",
    "validator": "^13.15.35"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#routes": "./src/routes/index.js",
    "#routes/*": "./src/routes/*"
  }
}
